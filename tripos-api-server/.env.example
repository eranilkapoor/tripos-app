NODE_ENV=development
HOST=localhost
PORT=4000
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:8081
API_PREFIX=api
API_VERSION=v1
API_BASE_URL=http://localhost:4000

# Use a dedicated TripOS database, not the Mentora database.
MONGO_URI=mongodb+srv://USER:PASSWORD@HOST/tripos?retryWrites=true
MONGO_AUTO_INDEX=true

JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ISSUER=tripos-api

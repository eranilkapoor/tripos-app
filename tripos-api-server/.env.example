# Application
NODE_ENV=development
HOST=localhost
PORT=4000
SHUTDOWN_DRAIN_MS=5000
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:8081
CORS_MAX_AGE_SECONDS=86400
API_PREFIX=api
API_VERSION=v1
API_BASE_URL=http://localhost:4000
APP_WEB_URL=http://localhost:3002
FRONTEND_URL=http://localhost:3002
COOKIE_DOMAIN=

# Database config - TripOS uses MongoDB, not PostgreSQL.
DB_DRIVER=mongo
MONGO_URI=mongodb://localhost:27017/tripos
MONGO_RETRY_ATTEMPTS=5
MONGO_RETRY_DELAY=5000
MONGO_AUTO_INDEX=true
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=0
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
MONGO_SOCKET_TIMEOUT_MS=45000
MONGO_SLOW_QUERY_THRESHOLD_MS=200

# Cache / queue config
CACHE_DRIVER=local
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASS=
REDIS_DB=0

# Global throttle config
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Auth/session config
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_AUDIENCE=user-refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_AUDIENCE=tripos-user
JWT_ISSUER=tripos-api
AUTH_MAX_CONCURRENT_SESSIONS=5
AUTH_MAGIC_LINK_ENABLED=false
AUTH_PHONE_OTP_ENABLED=false
AUTH_SOCIAL_GOOGLE_ENABLED=false
AUTH_SOCIAL_FACEBOOK_ENABLED=false
AUTH_MICROSOFT_ENABLED=false
AUTH_SAML_ENABLED=false

# Notification delivery setup
NOTIFICATION_QUEUE_ENABLED=false
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_EMAIL_PROVIDER=log
NOTIFICATION_EMAIL_FROM=support@tripos.local
NOTIFICATION_EMAIL_SMTP_HOST=
NOTIFICATION_EMAIL_SMTP_PORT=465
NOTIFICATION_EMAIL_SMTP_USERNAME=
NOTIFICATION_EMAIL_SMTP_PASSWORD=
NOTIFICATION_EMAIL_SMTP_SECURE=true
NOTIFICATION_SMS_ENABLED=false
NOTIFICATION_SMS_PROVIDER=log
NOTIFICATION_SMS_MSG91_AUTH_KEY=
NOTIFICATION_SMS_MSG91_TEMPLATE_ID=
NOTIFICATION_WHATSAPP_ENABLED=false
NOTIFICATION_WHATSAPP_PROVIDER=log

# Payments
PAYMENT_PROVIDER=log
PAYMENT_SIGNATURE_SECRET=
PAYMENT_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Travel CRM integrations
WHATSAPP_PROVIDER_ENABLED=false
WHATSAPP_PROVIDER=meta
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
GOOGLE_MAPS_ENABLED=false
GOOGLE_MAPS_API_KEY=
AI_PROVIDER_ENABLED=false
AI_PROVIDER=openai
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=
AI_PROVIDER_MODEL=
ACCOUNTING_EXPORT_PROVIDER=log
ACCOUNTING_EXPORT_API_KEY=
ACCOUNTING_EXPORT_BASE_URL=

# Storage config
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_BASE_URL=

# Monitoring / APM
MONITORING_ENABLED=false
MONITORING_PROVIDER=log
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
TRUST_PROXY_HOPS=0

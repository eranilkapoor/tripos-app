# Application
NODE_ENV=development
TRIPOS_ENABLE_DEMO_ADMIN=true
PUBLIC_LEAD_INTAKE_TOKEN=replace-with-shared-public-lead-token
PUBLIC_LEAD_ORGANIZATION_ID=demo-org
PUBLIC_LEAD_BRANCH_ID=main
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
HOST=localhost
PORT=4000
SHUTDOWN_DRAIN_MS=5000
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:8081
CORS_MAX_AGE_SECONDS=86400
API_PREFIX=api
API_VERSION=v1
API_BASE_URL=http://localhost:4000
APP_WEB_URL=http://localhost:3002
FRONTEND_URL=http://localhost:3002
COOKIE_DOMAIN=

# Database config - TripOS uses MongoDB, not PostgreSQL.
DB_DRIVER=mongo
MONGO_URI=mongodb://localhost:27017/tripos
MONGO_RETRY_ATTEMPTS=5
MONGO_RETRY_DELAY=5000
MONGO_AUTO_INDEX=true
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=0
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
MONGO_SOCKET_TIMEOUT_MS=45000
MONGO_SLOW_QUERY_THRESHOLD_MS=200

# Cache / queue config
CACHE_DRIVER=local
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASS=
REDIS_DB=0

# Global throttle config
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Auth/session config
AUTH_MAX_CONCURRENT_SESSIONS=5
AUTH_MAGIC_LINK_ENABLED=false
AUTH_PHONE_OTP_ENABLED=false
AUTH_SOCIAL_GOOGLE_ENABLED=false
AUTH_SOCIAL_FACEBOOK_ENABLED=false
AUTH_MICROSOFT_ENABLED=false
AUTH_SAML_ENABLED=false

# Notification delivery setup
INTEGRATION_SANDBOX_MODE=true
NOTIFICATION_QUEUE_ENABLED=true
NOTIFICATION_EMAIL_ENABLED=true
NOTIFICATION_EMAIL_PROVIDER=sandbox_smtp
NOTIFICATION_EMAIL_FROM=support@tripos.local
NOTIFICATION_EMAIL_SMTP_HOST=sandbox.smtp.local
NOTIFICATION_EMAIL_SMTP_PORT=1025
NOTIFICATION_EMAIL_SMTP_USERNAME=sandbox-user
NOTIFICATION_EMAIL_SMTP_PASSWORD=sandbox-password
NOTIFICATION_EMAIL_SMTP_SECURE=true
NOTIFICATION_SMS_ENABLED=true
NOTIFICATION_SMS_PROVIDER=sandbox_msg91
NOTIFICATION_SMS_MSG91_AUTH_KEY=sandbox-msg91-key
NOTIFICATION_SMS_MSG91_TEMPLATE_ID=sandbox-template
NOTIFICATION_WHATSAPP_ENABLED=true
NOTIFICATION_WHATSAPP_PROVIDER=sandbox_meta

# Payments
PAYMENT_PROVIDER=sandbox
PAYMENT_SIGNATURE_SECRET=sandbox-payment-signature-secret
PAYMENT_WEBHOOK_SECRET=sandbox-payment-webhook-secret
RAZORPAY_KEY_ID=rzp_test_sandbox_key
RAZORPAY_KEY_SECRET=sandbox-razorpay-secret
STRIPE_SECRET_KEY=sk_test_sandbox_key
STRIPE_WEBHOOK_SECRET=whsec_sandbox_secret

# Travel CRM integrations
WHATSAPP_PROVIDER_ENABLED=true
WHATSAPP_PROVIDER=sandbox_meta
WHATSAPP_ACCESS_TOKEN=sandbox-whatsapp-token
WHATSAPP_PHONE_NUMBER_ID=sandbox-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=sandbox-business-account-id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=sandbox-webhook-verify-token
WHATSAPP_APP_SECRET=sandbox-whatsapp-app-secret
GOOGLE_MAPS_ENABLED=true
GOOGLE_MAPS_API_KEY=sandbox-google-maps-key
AI_PROVIDER_ENABLED=true
AI_PROVIDER=sandbox_ai
AI_PROVIDER_API_KEY=sandbox-ai-key
AI_PROVIDER_BASE_URL=http://localhost:4000/sandbox/ai
AI_PROVIDER_MODEL=tripos-sandbox-assistant
DOCUMENT_RENDERER_ENABLED=true
DOCUMENT_RENDERER_PROVIDER=sandbox_html
DOCUMENT_RENDERER_API_KEY=sandbox-document-renderer-key
DOCUMENT_RENDERER_BASE_URL=http://localhost:4000/sandbox/documents
ACCOUNTING_EXPORT_ENABLED=true
ACCOUNTING_EXPORT_PROVIDER=sandbox_accounting
ACCOUNTING_EXPORT_API_KEY=sandbox-accounting-key
ACCOUNTING_EXPORT_BASE_URL=http://localhost:4000/sandbox/accounting

# Storage config
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_BASE_URL=

# Monitoring / APM
MONITORING_ENABLED=true
MONITORING_PROVIDER=sandbox_sentry
SENTRY_DSN=https://sandbox@sentry.local/1
SENTRY_TRACES_SAMPLE_RATE=0
TRUST_PROXY_HOPS=0

{
  "name": "tripos-api-server",
  "version": "1.0.0",
  "description": "NestJS API server for TripOS travel CRM, quotation, booking, B2B, operations, and finance workflows.",
  "author": "TripOS",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "npm run clean && nest build",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "npm run clean && nest start --watch",
    "start:prod": "node dist/main.js",
    "lint:check": "eslint \"{src,test}/**/*.ts\"",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist tsconfig.build.tsbuildinfo tsconfig.tsbuildinfo",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "seed": "ts-node -r tsconfig-paths/register src/modules/tripos/seed-tripos.ts",
    "migrate:collection-names": "ts-node -r tsconfig-paths/register src/modules/tripos/migrate-collection-names.ts",
    "contracts:generate-spec": "ts-node -r tsconfig-paths/register src/modules/tripos/generate-openapi.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.1",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/swagger": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "helmet": "^8.1.0",
    "mongoose": "^9.9.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.17",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.2.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "jest": "^30.0.0",
    "prettier": "^3.6.2",
    "rimraf": "^6.1.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.67.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "diagnostics": {
            "ignoreCodes": [
              151002
            ]
          }
        }
      ]
    },
    "testRegex": ".*\\.spec\\.ts$",
    "testEnvironment": "node",
    "coverageDirectory": "../coverage"
  }
}

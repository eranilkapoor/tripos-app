# Read by the browser bundle (destination/package pages, client lead form fallback).
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Server-only: used by app/api/demo-request/route.ts to forward validated,
# rate-limited lead submissions to the TripOS API. Never exposed to the client.
TRIPOS_API_URL=http://localhost:4000/api/v1
PUBLIC_LEAD_INTAKE_TOKEN=replace-with-shared-public-lead-token

# Used for sitemap.xml, robots.txt, and Open Graph metadata. Set to the real
# production domain once one exists.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

{
  "name": "tripos-mobile-app",
  "version": "0.1.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "expo": "~57.0.13",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.8",
    "react-native": "0.87.0",
    "react-native-safe-area-context": "5.9.0",
    "react-native-screens": "4.27.0"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/react": "~19.2.18",
    "babel-preset-expo": "57.0.7",
    "eslint": "^10.8.1",
    "eslint-config-expo": "^57.0.1",
    "jest": "^30.4.2",
    "jest-expo": "~57.0.4",
    "typescript": "~7.0.2"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/src/**/*.test.ts",
      "<rootDir>/src/**/*.test.tsx"
    ]
  }
}
